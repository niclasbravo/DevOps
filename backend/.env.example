# Copia este archivo a backend/.env y completa los valores. Nunca subas el .env al repositorio.
# Cada clave necesita al menos 32 bytes y debe ser distinta. Para generar una:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GM_PSEUDONYM_KEY=
# Admite varias claves separadas por coma: la primera cifra y todas descifran (rotación).
GM_EMAIL_KEY=
GM_JWT_SECRET=
# Ruta de la base. En Docker: /app/data/gamematch.db
GM_DB_PATH=data/gamematch.db

# Solo para entrenar el modelo
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
